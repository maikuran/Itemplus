{
  "multipart": [
    {
      "apply": { "model": "sakaplus:block/greeny_fence_gate", "uvlock": true }
    },
    {
      "when": { "facing": "west" },
      "apply": { "y": 90 }
    },
    {
      "when": { "facing": "north" },
      "apply": { "y": 180 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "y": 270 }
    },
    {
      "when": { "in_wall": "true" },
      "apply": { "model": "sakaplus:block/greeny_fence_gate_wall", "uvlock": true }
    },
    {
      "when": { "open": "true" },
      "apply": { "model": "sakaplus:block/greeny_fence_gate_open", "uvlock": true }
    },
    {
      "when": { "in_wall": "true", "open": "true" },
      "apply": { "model": "sakaplus:block/greeny_fence_gate_wall_open", "uvlock": true }
    }
  ]
}
